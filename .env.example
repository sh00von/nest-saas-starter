# ── App ─────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Comma-separated origins allowed to call the API with credentials.
CORS_ORIGINS=http://localhost:5173
# Public URL of this API (Google redirects back here).
API_URL=http://localhost:3000
# Public URL of the frontend (email links, Google and Stripe redirects).
FRONTEND_URL=http://localhost:5173
# Reverse-proxy hops to trust for client IPs (rate limits, session IPs). 0 = none.
TRUST_PROXY=0
# lax | strict | none — use `none` if the frontend is on a different site.
COOKIE_SAME_SITE=lax
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ── Database ────────────────────────────────────────
# Any Postgres. `pnpm db:local` (no install) → the default below.
# Neon/Supabase: paste their connection string (keep ?sslmode=require).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
# PGlite runs one query at a time; use ~10 for real Postgres.
DATABASE_POOL_MAX=1

# ── Auth ────────────────────────────────────────────
# At least 32 chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Used by `pnpm db:seed` to create an admin.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-please

# ── Redis (optional) ────────────────────────────────
# Enables the email queue (retries with backoff) and rate limits shared by all
# instances. Without it, emails send immediately and limits are per process.
# Free hosted option: Upstash. Local: docker run -p 6379:6379 redis
REDIS_URL=

# ── File uploads to S3 (optional — off when S3_BUCKET is unset) ──
# Bucket CORS must allow PUT from your frontend origin.
S3_BUCKET=
S3_REGION=us-east-1
# Leave empty to use the AWS default credentials chain (IAM role, ~/.aws).
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
UPLOAD_MAX_BYTES=10485760
# Comma-separated MIME types; empty = common images + PDF.
UPLOAD_ALLOWED_TYPES=

# ── Email (SMTP) ────────────────────────────────────
# Leave SMTP_HOST empty in development to print emails to the console.
# Works with any SMTP provider (Gmail app password, Resend, SES, Mailgun…).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=My App <no-reply@example.com>

# ── Google sign-in (optional — off when unset) ──────
# console.cloud.google.com → Credentials → OAuth client ID (Web application)
# Authorized redirect URI: <API_URL>/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Stripe (optional — billing routes are off when unset) ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Comma-separated price ids users are allowed to subscribe to.
STRIPE_PRICE_IDS=

# ── NestJS Observe (optional) ───────────────────────
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
